{
  "name": "kinetic",
  "version": "0.2.0",
  "private": true,
  "description": "First-person rooftop parkour time-trial",
  "author": "Jim-Wetering",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:html": "vite build --config vite.html.config.js",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis && electron-builder --win portable"
  },
  "devDependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "three": "0.128.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "build": {
    "appId": "com.jimwetering.kinetic",
    "productName": "Kinetic",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
