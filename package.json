{
  "name": "kinetic",
  "version": "0.1.0",
  "private": true,
  "description": "First-person rooftop parkour time-trial",
  "author": "Jim-Wetering",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis && electron-builder --win portable"
  },
  "devDependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "three": "0.128.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.jimwetering.kinetic",
    "productName": "Kinetic",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "${productName}-${version}-portable.exe" }
  }
}
